# Sanitized backend configuration template; contains no working credentials.
# Copy to .env for local reference and fill in values privately.
# Spring Boot/Maven do not automatically load .env. Set these variables in the
# process environment before starting the backend (for example in PowerShell).
# Never commit the populated .env or paste its values into logs or PRs.

# Optional: these match the defaults in src/main/resources/application-local.yml.
DB_URL=jdbc:postgresql://localhost:5432/secret_shield_db
DB_USERNAME=postgres

# Required: replace the empty value with your local PostgreSQL password.
DB_PASSWORD=

# Required: generate a private random secret with at least 32 UTF-8 bytes.
# JwtService uses these bytes directly, rather than decoding a Base64 value.
# Leave this template empty; never use an example/shared secret at runtime.
JWT_SECRET=
SCANNER_WORKSPACE=target/scanner-workspace
GITLEAKS_PATH=gitleaks
GITLEAKS_CONFIG_PATH=config/gitleaks.toml
SCANNER_TIMEOUT_SECONDS=60

# Optional: one exact browser frontend origin; no path or trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Notifications are disabled until recipients are explicitly configured.
# Use fake locally; use azure only after ACS/domain/sender setup in M14.
NOTIFICATION_PROVIDER=disabled
# Stable aliases and private addresses, e.g. security=alerts@example.invalid.
# Do not put recipients in source control or share populated values.
NOTIFICATION_RECIPIENTS=
NOTIFICATION_PUBLIC_BASE_URL=http://localhost:8080
# Azure mode only: keep the actual connection string and verified sender private.
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
