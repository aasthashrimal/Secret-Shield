# Sanitized backend configuration template; contains no working credentials.
# Copy to .env for local reference and fill in values privately.
# Spring Boot/Maven do not automatically load .env. Set these variables in the
# process environment before starting the backend (for example in PowerShell).
# Never commit the populated .env or paste its values into logs or PRs.

# Optional: these match the defaults in src/main/resources/application-local.yml.
DB_URL=jdbc:postgresql://localhost:5432/secret_shield_db
DB_USERNAME=postgres

# Required: replace the empty value with your local PostgreSQL password.
DB_PASSWORD=

# Required: generate a private random secret with at least 32 UTF-8 bytes.
# JwtService uses these bytes directly, rather than decoding a Base64 value.
# Leave this template empty; never use an example/shared secret at runtime.
JWT_SECRET=
